{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@0.0.83",
        "--config",
        ".pi/playwright-mcp.json"
      ],
      "exposure": "codemode",
      "description": "Playwright browser tests with a separate in-memory Chromium profile; never shares the personal browser login."
    },
    "lightpanda": {
      "command": "~/.local/bin/lightpanda",
      "args": [
        "mcp",
        "--block-private-networks",
        "--block-cidrs",
        "-127.0.0.1/32",
        "--obey-robots"
      ],
      "exposure": "codemode",
      "description": "Lightpanda-browser: webpagina's bezoeken, lezen en bedienen"
    },
    "oomagent-pi": {
      "enabled": false,
      "command": "python3",
      "args": [
        "-m",
        "uv",
        "run",
        "--python",
        "3.13",
        "--script",
        "/Users/buurtkamer/Projects/oomagent-test/oomagent-mcp-pi/server.py"
      ],
      "exposure": "codemode",
      "description": "Lokale MCP bridge naar mijn OomAgent Pi coding agent"
    },
    "crypto": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--read-only",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges",
        "--tmpfs",
        "/tmp",
        "--env-file",
        "/Users/buurtkamer/Projects/oomagent/oomagent-mcp-crypto/.env",
        "oomagent-mcp-crypto:local"
      ],
      "exposure": "codemode",
      "timeout": 30,
      "description": "Eigen Crypto MCP: publieke USD-prijzen, 24h-verandering, vergelijking en samenvatting via CoinGecko; geen financieel advies."
    }
  }
}
