#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "$ROOT/portable/env.sh"
# Start the local MCP service only for actual sessions / MCP diagnostics.
START_ZAP=1
case "${1:-}" in auth|install|remove|uninstall|update|config|list) START_ZAP=0 ;; esac
for arg in "$@"; do
  case "$arg" in --no-mcp|--no-extensions|-ne|--help|-h|--version|-v|--list-models) START_ZAP=0 ;; esac
done
if [[ "$START_ZAP" == 1 ]]; then node "$ROOT/portable/zap.mjs" start; fi
exec node "$STATE/pi-source/packages/coding-agent/dist/cli.js" "$@"
