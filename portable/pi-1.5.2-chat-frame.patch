diff --git a/packages/tui/src/components/frame.ts b/packages/tui/src/components/frame.ts
new file mode 100644
index 0000000..f998da4
--- /dev/null
+++ b/packages/tui/src/components/frame.ts
@@ -0,0 +1,50 @@
+import { type FrameLayoutNode, LAYOUT_NODE } from "../layout-node.ts";
+import { type Component, compositeTuiLine } from "../tui.ts";
+import { truncateToWidth, visibleWidth } from "../utils.ts";
+
+/** A one-cell border that preserves its child's fullscreen layout and hit targets. */
+export class Frame implements Component {
+	readonly child: Component;
+	readonly title: string;
+	readonly borderStyle: (text: string) => string;
+
+	constructor(child: Component, title: string, borderStyle: (text: string) => string) {
+		this.child = child;
+		this.title = title;
+		this.borderStyle = borderStyle;
+	}
+
+	invalidate(): void {
+		this.child.invalidate?.();
+	}
+
+	renderBorder(width: number, height: number): string[] {
+		const label = truncateToWidth(` ${this.title} `, width - 2, "");
+		return [
+			this.borderStyle(`┌${label}${"─".repeat(Math.max(0, width - 2 - visibleWidth(label)))}┐`),
+			...Array.from(
+				{ length: Math.max(0, height - 2) },
+				() => `${this.borderStyle("│")}${" ".repeat(width - 2)}${this.borderStyle("│")}`,
+			),
+			this.borderStyle(`└${"─".repeat(width - 2)}┘`),
+		];
+	}
+
+	render(width: number): string[] {
+		if (width < 3) return this.child.render(width).map((line) => truncateToWidth(line, width, ""));
+		const content = this.child.render(width - 2);
+		const lines = this.renderBorder(width, content.length + 2);
+		for (let row = 0; row < content.length; row++) {
+			lines[row + 1] = compositeTuiLine(lines[row + 1]!, content[row]!, 1, width - 2, width);
+		}
+		return lines;
+	}
+
+	[LAYOUT_NODE](): FrameLayoutNode {
+		return {
+			type: "frame",
+			component: this.child,
+			renderBorder: (width, height) => this.renderBorder(width, height),
+		};
+	}
+}
diff --git a/packages/tui/test/frame.test.ts b/packages/tui/test/frame.test.ts
new file mode 100644
index 0000000..6b13df4
--- /dev/null
+++ b/packages/tui/test/frame.test.ts
@@ -0,0 +1,96 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { Frame } from "../src/components/frame.ts";
+import { ScrollView } from "../src/components/scroll-view.ts";
+import { Text } from "../src/components/text.ts";
+import { getLayoutBoxesAt, getScrollViewBox, getScrollViewsAt, renderLayoutFrame } from "../src/layout.ts";
+import { encodeKitty, registerKittyImageMetadata } from "../src/terminal-image.ts";
+import { CURSOR_MARKER } from "../src/tui.ts";
+import { stripTerminalSequences, visibleWidth } from "../src/utils.ts";
+
+const blue = (text: string) => `\x1b[34m${text}\x1b[39m`;
+
+describe("Frame", () => {
+	it("draws a titled border and keeps content and cursor inside it", () => {
+		const content = new Text(`hi${CURSOR_MARKER}`, 0, 0);
+		const frame = new Frame(content, "π", blue);
+		const result = renderLayoutFrame(frame, 8, 4, () => {});
+		assert.deepEqual(result.lines.map(stripTerminalSequences), ["┌ π ───┐", "│hi    │", "│      │", "└──────┘"]);
+		assert.ok(result.lines[0]!.includes("\x1b[34m"));
+		assert.ok(result.lines[1]!.includes(CURSOR_MARKER));
+		assert.equal(getLayoutBoxesAt(result, 1, 1)[0]!.component, content);
+		assert.equal(getLayoutBoxesAt(result, 0, 1)[0]!.component, frame);
+	});
+
+	it("keeps the frame fixed when scrolling and reserves the scrollbar inside it", () => {
+		const scroll = new ScrollView(new Text("one\ntwo\nthree\nfour\nfive", 0, 0), {
+			follow: "end",
+			primary: true,
+			scrollbar: "always",
+		});
+		const frame = new Frame(scroll, "π", blue);
+		const render = () => renderLayoutFrame(frame, 12, 5, () => {});
+		const bottom = render();
+		assert.equal(bottom.primaryScrollView, scroll);
+		assert.deepEqual(getScrollViewBox(bottom, scroll)!.rect, { x: 1, y: 1, width: 10, height: 3 });
+		assert.deepEqual(getScrollViewsAt(bottom, 2, 2), [scroll]);
+		assert.deepEqual(getScrollViewsAt(bottom, 0, 2), []);
+		assert.ok(bottom.lines.join("\n").includes("five"));
+		scroll.scrollToStart();
+		const top = render();
+		assert.equal(top.lines[0], bottom.lines[0]);
+		assert.equal(top.lines[4], bottom.lines[4]);
+		assert.ok(top.lines.join("\n").includes("one"));
+		for (const line of top.lines.slice(1, -1)) {
+			assert.ok(stripTerminalSequences(line).startsWith("│"));
+			assert.ok(stripTerminalSequences(line).endsWith("│"));
+		}
+	});
+
+	it("handles empty content, unicode, narrow widths, resize and tiny heights", () => {
+		for (const text of ["", "界🙂é long line"]) {
+			const frame = new Frame(new Text(text, 0, 0), "π 界🙂", blue);
+			for (const width of [30, 3, 2, 1, 30]) {
+				for (const height of [8, 3, 2, 1]) {
+					const result = renderLayoutFrame(frame, width, height, () => {});
+					assert.equal(result.lines.length, height);
+					assert.ok(
+						result.lines.every((line) => visibleWidth(line) <= width),
+						JSON.stringify({ text, width, height, lines: result.lines }),
+					);
+				}
+			}
+		}
+	});
+
+	it("keeps partially scrolled images inside the border", () => {
+		const imageId = 125;
+		const imageLine = encodeKitty("AAAA", { columns: 2, rows: 3, imageId, moveCursor: false });
+		registerKittyImageMetadata({ imageId, columns: 2, rows: 3, widthPx: 100, heightPx: 90 });
+		const scroll = new ScrollView({ render: () => [imageLine, "", "", "after"], invalidate() {} });
+		const frame = new Frame(scroll, "π", blue);
+		renderLayoutFrame(frame, 20, 4, () => {});
+		scroll.scrollBy(1);
+		const result = renderLayoutFrame(frame, 20, 4, () => {});
+		assert.ok(result.lines[1]!.includes("y=30,h=60,r=2"));
+		assert.ok(stripTerminalSequences(result.lines[1]!).startsWith("│"));
+		assert.ok(stripTerminalSequences(result.lines[1]!).endsWith("│"));
+	});
+
+	it("supports intrinsic rendering and propagates invalidation", () => {
+		let invalidated = false;
+		const frame = new Frame(
+			{
+				render: () => ["hello"],
+				invalidate: () => {
+					invalidated = true;
+				},
+			},
+			"π",
+			blue,
+		);
+		assert.deepEqual(frame.render(9).map(stripTerminalSequences), ["┌ π ────┐", "│hello  │", "└───────┘"]);
+		frame.invalidate();
+		assert.equal(invalidated, true);
+	});
+});
